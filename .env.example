# Salin file ini menjadi .env di setiap device, lalu sesuaikan.
# Lokasi folder aset berat di device ini. Sementara boleh menunjuk ke folder proyek lama (pov/), karena aset dan render lama masih di sana.
# Contoh Windows:  ASET_DIR=G:/My Drive/UlikSilam/aset
# Contoh macOS:    ASET_DIR=/Users/rafi/Library/CloudStorage/GoogleDrive-.../My Drive/UlikSilam/aset
ASET_DIR=
